# Realtime Image Optimizer - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# CORS Configuration (Future Use)
# ===========================================
# Comma-separated list of allowed origins
# Leave empty or set to "*" to allow all origins
# Example: https://example.com,https://app.example.com
# ALLOWED_ORIGINS=*

# ===========================================
# Image Source Configuration (Future Use)
# ===========================================
# Comma-separated list of allowed image source domains
# Leave empty to allow all domains
# Example: images.example.com,cdn.example.com,uploadthing.com
# ALLOWED_IMAGE_DOMAINS=

